#!/usr/bin/env python3
"""Read Codex/Claude quota snapshots and last-request cache tokens on the VPS."""

import argparse
from datetime import datetime
import json
import math
from pathlib import Path
import subprocess
import sys


QUERY = """
BEGIN READ ONLY;
SET LOCAL statement_timeout = '3s';
SET LOCAL lock_timeout = '1s';
SELECT COALESCE(json_agg(json_build_object(
    'id', a.id, 'platform', a.platform, 'name', a.name, 'status', a.status, 'schedulable', a.schedulable,
    'updated_at', CASE a.platform WHEN 'openai' THEN a.extra->>'codex_usage_updated_at'
        ELSE a.extra->>'passive_usage_sampled_at' END,
    'last_used_at', a.last_used_at,
    'rate_limit_reset_at', a.rate_limit_reset_at,
    'overload_until', a.overload_until,
    'temp_unschedulable_until', a.temp_unschedulable_until,
    'input_tokens', u.input_tokens,
    'cache_creation_tokens', u.cache_creation_tokens,
    'cache_read_tokens', u.cache_read_tokens,
    'windows', json_build_array(
        json_build_object('label', '5h',
            'minutes', CASE a.platform WHEN 'openai' THEN a.extra->'codex_5h_window_minutes' ELSE '300'::jsonb END,
            'used', CASE a.platform WHEN 'openai' THEN a.extra->'codex_5h_used_percent'
                ELSE a.extra->'session_window_utilization' END,
            'reset_at', CASE a.platform WHEN 'openai' THEN a.extra->>'codex_5h_reset_at'
                ELSE a.session_window_end::text END),
        json_build_object('label', '7d',
            'minutes', CASE a.platform WHEN 'openai' THEN a.extra->'codex_7d_window_minutes' ELSE '10080'::jsonb END,
            'used', CASE a.platform WHEN 'openai' THEN a.extra->'codex_7d_used_percent'
                ELSE a.extra->'passive_usage_7d_utilization' END,
            'reset_at', CASE a.platform WHEN 'openai' THEN a.extra->>'codex_7d_reset_at'
                ELSE CASE WHEN (a.extra->>'passive_usage_7d_reset')::double precision > 0
                    THEN to_timestamp((a.extra->>'passive_usage_7d_reset')::double precision)::text END END)
    )
) ORDER BY CASE a.platform WHEN 'openai' THEN 0 ELSE 1 END, a.id), '[]'::json)
FROM accounts a
LEFT JOIN LATERAL (
    SELECT input_tokens, cache_creation_tokens, cache_read_tokens
    FROM usage_logs WHERE account_id = a.id
    ORDER BY created_at DESC, id DESC LIMIT 1
) u ON TRUE
WHERE a.platform IN ('openai', 'anthropic') AND a.type = 'oauth' AND a.deleted_at IS NULL;
ROLLBACK;
"""


def timestamp(value):
    if value is None:
        return None
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise ValueError("Snapshot timestamp has no timezone")
    return int(parsed.timestamp())


def normalize(rows):
    accounts = []
    claude_count = 0
    for row in rows:
        provider = {"openai": "Codex", "anthropic": "Claude"}[row["platform"]]
        if provider == "Claude":
            claude_count += 1
        windows = []
        for window in row["windows"]:
            used = window["used"]
            minutes = window["minutes"]
            if used is not None and (type(used) not in (int, float)
                                     or not math.isfinite(used) or not 0 <= used <= (1 if provider == "Claude" else 100)):
                raise ValueError("Invalid quota percentage")
            if used is not None and provider == "Claude":
                used *= 100
            if minutes is not None and (type(minutes) not in (int, float)
                                        or not math.isfinite(minutes) or minutes < 0):
                raise ValueError("Invalid quota window")
            windows.append({
                "label": window["label"],
                "used_percent": used if used is not None and minutes else None,
                "reset_at": timestamp(window["reset_at"]),
            })
        tokens = [row[field] for field in ("input_tokens", "cache_creation_tokens", "cache_read_tokens")]
        if any(value is not None and (type(value) is not int or value < 0) for value in tokens):
            raise ValueError("Invalid cache token count")
        # sub2api stores ordinary input, cache writes and cache reads as disjoint token buckets.
        cache_miss = tokens[0] + tokens[1] if tokens[0] is not None and tokens[1] is not None else None
        accounts.append({
            "id": row["id"], "name": row["name"] if provider == "Codex" else f"ClaudeAccount{claude_count}",
            "provider": provider,
            "status": row["status"],
            "schedulable": row["schedulable"], "updated_at": timestamp(row["updated_at"]),
            "last_used_at": timestamp(row["last_used_at"]),
            "rate_limit_reset_at": timestamp(row["rate_limit_reset_at"]),
            "overload_until": timestamp(row["overload_until"]),
            "temp_unschedulable_until": timestamp(row["temp_unschedulable_until"]),
            "cache_miss_tokens": cache_miss, "cache_hit_tokens": tokens[2],
            "windows": windows,
        })
    return accounts


def read_accounts():
    result = subprocess.run(
        ["docker", "exec", "-i", "--user", "postgres", "sub2api-postgres", "sh", "-c",
         'exec psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"'],
        input=QUERY, text=True, capture_output=True, check=True, timeout=8,
    )
    return json.loads(result.stdout)


def fetch(host):
    # Send this exact source to avoid installing a second copy on the VPS.
    result = subprocess.run(
        ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
         "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=1",
         "--", host, "python3", "-", "--snapshot"],
        input=Path(__file__).read_text(), text=True, capture_output=True, check=True, timeout=20,
    )
    return json.loads(result.stdout)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="ruweb_hosting", help="SSH host (default: ruweb_hosting)")
    parser.add_argument("--snapshot", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    try:
        payload = {"accounts": normalize(read_accounts())} if args.snapshot else fetch(args.host)
        print(json.dumps(payload, ensure_ascii=False, allow_nan=False))
        return 0
    except subprocess.TimeoutExpired:
        error, code = "Server timeout", 2
    except subprocess.CalledProcessError as exc:
        if args.snapshot:
            error, code = "Quota read error", 4
        elif exc.returncode in (2, 3, 4):
            error, code = "Failed to fetch quota data", exc.returncode
        else:
            error, code = "Server unavailable", 1
    except (ValueError, TypeError, KeyError):
        error, code = "Invalid quota data", 3
    except OSError:
        error, code = "Failed to launch collector", 1
    print(error, file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
