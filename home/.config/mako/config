# ── mako notification daemon ──────────────────────────────────
# Font, colours, border, rounding: ~/.config/theme/theme.json (see "colours" below)

# ── layout ────────────────────────────────────────────────────
anchor=top-right
layer=overlay
margin=12
padding=12,16
width=380
height=120

# ── icons ─────────────────────────────────────────────────────
icons=1
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
max-icon-size=48
icon-border-radius=4

# ── behaviour ─────────────────────────────────────────────────
markup=1
actions=1
history=1
max-history=20
max-visible=5
sort=-time

# app name above the summary; notifications of one app fold into one card (format: [grouped] below)
format=<span size="small" alpha="65%%">%a</span>\n<b>%s</b>\n%b
group-by=app-name

default-timeout=5000
ignore-timeout=0

# ── colours ───────────────────────────────────────────────────
# Font and colours generated from theme.json by ~/.local/bin/mako-theme: at login before mako, and by Quickshell on every
# theme change. mako won't start without this file
include=~/.cache/mako-theme

# ── urgency overrides ─────────────────────────────────────────
[urgency=low]
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=high]
default-timeout=0

[grouped]
format=<span size="small" alpha="65%%">%a · %g</span>\n<b>%s</b>\n%b

# ── apps ──────────────────────────────────────────────────────
# track changes: brief, and kept out of the history
[app-name=Spotify]
default-timeout=2000
history=0

# mako-dnd's "Notifications enabled"
[app-name=mako]
history=0

[mode=do-not-disturb]
invisible=1
