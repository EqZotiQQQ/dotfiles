;;; eww.yuck — cava-eww visualizer widget
;;;
;;; Структура файла:
;;;   1. defvar / defpoll  — источники данных (три варианта)
;;;   2. defwidget         — компоненты (бар, окно)
;;;   3. defwindow         — окна Hyprland
;;;
;;; Установка:
;;;   ~/.config/eww/eww.yuck  (или include из основного конфига)
;;;
;;; Запуск:
;;;   eww open cava-bar        ; нижний бар
;;;   eww open cava-overlay    ; плавающее окно поверх всего
;;;
;;; ─────────────────────────────────────────────────────────────────────────────
;;; ЧАСТЬ 1: Источники данных
;;; Выберите ОДИН вариант из трёх и раскомментируйте его.
;;; ─────────────────────────────────────────────────────────────────────────────

;;; ── Вариант A: defpoll (самый простой) ───────────────────────────────────────
;;; cava-eww запускается EWW каждые 50ms и читает stdout.
;;; Плюсы: нет внешних процессов, EWW управляет lifecycle.
;;; Минусы: fork каждые 50ms (~20 fork/sec), небольшой overhead.
;;;
;;; Запуск приложения НЕ нужен — EWW запускает сам.

(defpoll cava-bars
  :interval "50ms"
  ;; :run-while — не опрашиваем пока виджет скрыт (экономия CPU)
  :run-while cava-visible
  ;; Без --color: чистый текст, EWW сам красит через CSS
  `${EWW_CONFIG_DIR}/bin/cava-eww --bars 20 --no-color --sep ""`)

;;; ── Вариант B: defvar + eww update (рекомендуется для цветов) ───────────────
;;; cava-eww работает как daemon и сам вызывает `eww update`.
;;; Плюсы: Pango markup с цветами, нет fork overhead.
;;; Минусы: нужно запустить daemon отдельно (systemd unit ниже).
;;;
;;; Запуск: systemctl --user start cava-eww
;;; или:    cava-eww --eww --var cava-bars --color "#5e81f4" "#f45e81" &

;; (defvar cava-bars "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁")

;;; ── Вариант C: defpoll + named pipe (низкая латентность) ─────────────────────
;;; cava-eww пишет в FIFO, EWW читает последнюю строку.
;;; Плюсы: минимальная латентность, нет fork.
;;; Минусы: нужно запустить daemon, tail процесс живёт постоянно.
;;;
;;; Запуск: cava-eww --pipe --pipe-path /tmp/cava-eww.fifo &

;; (defpoll cava-bars
;;   :interval "50ms"
;;   :run-while cava-visible
;;   `tail -1 /tmp/cava-eww.fifo 2>/dev/null || echo "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"`)

;;; ── Состояние видимости (для :run-while) ────────────────────────────────────
;;; Переключается при открытии/закрытии окна.
;;; Позволяет останавливать опрос когда бар скрыт.
(defvar cava-visible true)

;;; ─────────────────────────────────────────────────────────────────────────────
;;; ЧАСТЬ 2: Виджеты
;;; ─────────────────────────────────────────────────────────────────────────────

;;; ── Основной виджет визуализатора ────────────────────────────────────────────
(defwidget cava-visualizer []
  (box
    :class       "cava-visualizer"
    :orientation "h"
    :halign      "center"
    :valign      "center"
    :space-evenly false
    (label
      ;; use-markup: нужно для Pango <span color="..."> из варианта B
      ;; При варианте A (no-color) markup не используется, но вреда нет
      :use-markup true
      :class      "cava-label"
      :text       cava-bars)))

;;; ── Виджет с заголовком (плеер + визуализатор) ───────────────────────────────
(defwidget cava-with-title []
  (box
    :class       "cava-container"
    :orientation "v"
    :space-evenly false
    :spacing     4
    ;; Название трека (если есть playerctl)
    (label
      :class     "cava-track-title"
      :truncate  true
      :text      {music-title})
    (cava-visualizer)))

;;; ── Заглушка когда нет данных ────────────────────────────────────────────────
(defwidget cava-idle []
  (box
    :class "cava-visualizer cava-idle"
    (label
      :class "cava-label"
      ;; 20 нижних блоков — "спящее" состояние
      :text  "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁")))

;;; ─────────────────────────────────────────────────────────────────────────────
;;; ЧАСТЬ 3: Окна
;;; ─────────────────────────────────────────────────────────────────────────────

;;; ── Нижний бар (основное использование) ─────────────────────────────────────
;;; Показывается в нижней части экрана, растянут по ширине.
;;; Гибрид с остальными элементами бара — добавьте cava-visualizer
;;; в свой существующий bar.yuck.
(defwindow cava-bar
  ;; Монитор: "" = основной, "DP-1" = конкретный
  :monitor     ""
  :geometry    (geometry
                 :x           "0px"
                 :y           "0px"
                 :width       "100%"
                 :height      "40px"
                 :anchor      "bottom center")
  ;; exclusive: зарезервировать место (не перекрывает другие окна)
  :exclusive   true
  ;; stacking: background — под всеми окнами; foreground — над всеми
  :stacking    "foreground"
  :focusable   false
  ;; windowtype: dock сообщает Hyprland это панель
  :windowtype  "dock"
  (box
    :class       "cava-bar-window"
    :orientation "h"
    :halign      "fill"
    :valign      "center"
    :hexpand     true
    (cava-visualizer)))

;;; ── Плавающее окно поверх всего ──────────────────────────────────────────────
;;; Компактное окно по центру экрана — для использования
;;; поверх fullscreen или как standalone виджет.
(defwindow cava-overlay
  :monitor     ""
  :geometry    (geometry
                 :x      "50%"
                 :y      "10px"
                 :width  "400px"
                 :height "50px"
                 :anchor "top center")
  :stacking    "overlay"
  :focusable   false
  :windowtype  "notification"
  (box
    :class "cava-overlay-window"
    (cava-visualizer)))

;;; ── Интеграция в существующий бар ────────────────────────────────────────────
;;; Если у вас уже есть eww bar — просто вставьте (cava-visualizer)
;;; в нужное место вашего defwindow. Пример:
;;;
;;; (defwindow my-bar
;;;   ...
;;;   (box :orientation "h"
;;;     (workspaces)        ; ваши виджеты
;;;     (cava-visualizer)   ; ← сюда
;;;     (clock)))

;;; ─────────────────────────────────────────────────────────────────────────────
;;; ЧАСТЬ 4: Опциональные зависимые виджеты
;;; ─────────────────────────────────────────────────────────────────────────────

;;; Название текущего трека через playerctl (опционально)
;;; Требует: pacman -S playerctl
(defpoll music-title
  :interval    "2s"
  :initial     ""
  `playerctl metadata --format "{{artist}} — {{title}}" 2>/dev/null || echo ""`)
