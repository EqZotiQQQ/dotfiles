#!/bin/bash

CACHE="/tmp/eww_network_cache"

fmt_speed() {
    local b=$1
    if   [ "$b" -ge 1048576 ]; then printf "%.1fM" "$(awk "BEGIN{printf \"%.1f\", $b/1048576}")"
    elif [ "$b" -ge 1024 ];    then printf "%dK"   $(( b / 1024 ))
    else                            printf "%dB"   "$b"
    fi
}

iface=$(ip -o link show up | awk '{print $2}' | tr -d ':' | grep -v '^lo$' | head -1)

if [ -z "$iface" ]; then
    echo "󰌙"
    exit 0
fi

rx_now=$(< "/sys/class/net/$iface/statistics/rx_bytes")
tx_now=$(< "/sys/class/net/$iface/statistics/tx_bytes")
time_now=$(date +%s)

rx_speed=0
tx_speed=0

if [ -f "$CACHE" ]; then
    # shellcheck source=/dev/null
    source "$CACHE"
    if [ "$iface_prev" = "$iface" ]; then
        dt=$(( time_now - time_prev ))
        [ "$dt" -gt 0 ] && {
            rx_speed=$(( (rx_now - rx_prev) / dt ))
            tx_speed=$(( (tx_now - tx_prev) / dt ))
        }
    fi
fi

printf "iface_prev=%s\nrx_prev=%d\ntx_prev=%d\ntime_prev=%d\n" \
    "$iface" "$rx_now" "$tx_now" "$time_now" > "$CACHE"

if [[ "$iface" == wl* ]]; then
    dbm=$(iw dev "$iface" link 2>/dev/null | awk '/signal/{print $2}')
    if [ -n "$dbm" ]; then
        signal=$(( 2 * (dbm + 100) ))
        [ "$signal" -gt 100 ] && signal=100
        [ "$signal" -lt 0 ]   && signal=0
    else
        signal=0
    fi
    prefix="󰤨  ${signal}%"
else
    prefix="󰈀  $iface"
fi

echo "$prefix  ↓$(fmt_speed $rx_speed) ↑$(fmt_speed $tx_speed)"
