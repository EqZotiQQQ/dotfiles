; ── polls ────────────────────────────────────────────────────────────

(defpoll clock-time :interval "1s"
  :initial "00:00"
  `date '+%H:%M'`)

(defpoll clock-date :interval "60s"
  :initial ""
  `date '+%a, %d %b %Y'`)

(defpoll volume-text :interval "1s"
  :initial "󰕾  0%"
  `~/.config/eww/scripts/volume`)

(defpoll cpu-usage :interval "1s"
  :initial "0"
  `~/.config/eww/scripts/cpu`)

(defpoll temperature :interval "1s"
  :initial "0"
  `awk '{printf "%d", $1/1000}' /sys/class/hwmon/hwmon2/temp1_input`)

(defpoll memory-pct :interval "1s"
  :initial "0"
  `free | awk '/Mem:/{printf "%d", $3/$2*100}'`)

(defpoll audio-sinks :interval "100ms"
  :initial "[]"
  `~/.config/eww/scripts/audio-sinks`)

(defpoll memory-details :interval "3s"
  :initial '{
    "total":"0G","used":"0G","cached":"0G","swap_used":"0G","swap_total":"0G",
    "used_pct":0,"cache_pct":0,"swap_pct":0,"has_swap":false,"procs":[]
  }'
  `~/.config/eww/scripts/memory-details`)

(defpoll cpu-cores :interval "1s"
  :initial '{"cores":[],"procs":[]}'
  `~/.config/eww/scripts/cpu-cores`)

(defpoll temperatures :interval "2s"
  :initial "[]"
  `~/.config/eww/scripts/temperatures`)

(defpoll network-text :interval "1s"
  :initial "󰌙"
  `~/.config/eww/scripts/network`)

(defpoll language :interval "1s"
  :initial "EN"
  `hyprctl devices -j | jq -r '[.keyboards[] | select(.main==true)][0].active_keymap' | grep -qi "russian" && echo "RU" || echo "EN"`)


(defpoll dnd-status :interval "1s"
  :initial "false"
  `makoctl mode | grep -qx do-not-disturb && echo "true" || echo "false"`)

; ── listens ───────────────────────────────────────────────────────────

(deflisten workspaces
  :initial '[{"id":1,"label":1,"active":true,"occupied":true}]'
  `~/.local/scripts/workspaces 1 9 DP-2 0`)

(deflisten workspaces2
  :initial '[{"id":10,"label":1,"active":false,"occupied":true}]'
  `~/.local/scripts/workspaces 10 18 DP-1 9`)

(deflisten active-window
  :initial ""
  `~/.config/eww/scripts/active-window`)

; ── state vars ────────────────────────────────────────────────────────

(defvar cpu-graph-secs 60)

(defvar show-date false)
(defvar volume-opacity 1)
(defvar cpu-pin false)
(defvar temp-pin false)
(defvar ram-pin false)
(defvar sink-pin false)
(defvar power-pin false)

; ── widgets ───────────────────────────────────────────────────────────

(defwidget bar [wss]
  (centerbox :orientation "h" :class "bar"
    (bar-left :wss wss)
    (bar-center)
    (bar-right)))

(defwidget bar-left [wss]
  (box :class "pill" :orientation "h" :spacing 4 :space-evenly false :halign "start"
    (workspaces-widget :wss wss)
    (active-window-widget)))

(defwidget bar-center []
  (box :class "pill" :orientation "h" :halign "center"
    (clock-widget)))

(defwidget bar-right []
  (box :class "pill" :orientation "h" :spacing 0 :space-evenly false :halign "end"
    (dnd-widget)
    (language-widget)
    (volume-widget)
    (network-widget)
    (cpu-widget)
    (temp-widget)
    (memory-widget)
    (power-widget)))

(defwidget workspaces-widget [wss]
  (box :orientation "h" :spacing 2 :space-evenly false
    (for ws in wss
      (button
        :class {ws.active ? "ws-btn active" : "ws-btn occupied"}
        :onclick "hyprctl dispatch workspace ${ws.id}"
        "${ws.label}"))))

(defwidget active-window-widget []
  (label
    :class "window-title"
    :text {active-window}
    :limit-width 50
    :truncate true))

(defwidget clock-widget []
  (button
    :class "clock module"
    :onclick "eww update show-date=${show-date ? false : true}"
    {show-date ? "  ${clock-date}" : "  ${clock-time}"}))

(defwidget power-widget []
  (eventbox
    :onhover     "~/.config/eww/scripts/popup-open power-popup-window power-pin"
    :onhoverlost "~/.config/eww/scripts/popup-hover-out power-popup-window power-pin"
    :onclick     "~/.config/eww/scripts/popup-toggle power-popup-window power-pin"
    (label :class "power module" :text "󰐥")))

(defwidget power-popup-widget []
  (eventbox
    :onhoverlost "eww update power-pin=false; eww close power-popup-window-0 2>/dev/null; eww close power-popup-window-1 2>/dev/null"
    (box :orientation "v" :spacing 4 :class "popup-box"
      (button :class "power-btn power-btn-sleep"    :onclick "systemctl suspend"     "󰒲  Sleep")
      (button :class "power-btn power-btn-logout"   :onclick "hyprctl dispatch exit" "󰍃  Logout")
      (button :class "power-btn power-btn-reboot"   :onclick "systemctl reboot"      "󰜉  Reboot")
      (button :class "power-btn power-btn-shutdown" :onclick "systemctl poweroff"    "󰐥  Shutdown"))))

(defwidget dnd-widget []
  (button
    :class "dnd module"
    :onclick "~/.local/bin/mako-dnd"
    {dnd-status == "true" ? "󰂛" : "󰂚"}))

(defwidget language-widget []
  (label :class "language module" :xalign 0.5 :text "  ${language}"))

(defwidget volume-widget []
  (eventbox
    :onclick        "~/.config/eww/scripts/volume mute"
    :onscroll       "~/.config/eww/scripts/volume {}"
    :onrightclick   "~/.config/eww/scripts/popup-open sink-popup-window"
    (label :class "volume module"
           :xalign 0.5
           :text {volume-text}
           :style "opacity: ${volume-opacity}; transition: opacity 150ms ease;")))

(defwidget sink-popup-widget []
  (eventbox
    :onhoverlost "eww close sink-popup-window-0 2>/dev/null; eww close sink-popup-window-1 2>/dev/null"
    (box :orientation "v" :spacing 4 :class "popup-box"
      (for sink in audio-sinks
        (button
          :class {sink.active ? "sink-btn sink-btn-active" : "sink-btn"}
          :onclick "~/.config/eww/scripts/audio-sink-select '${sink.name}'"
          {sink.active ? "  ${sink.desc}" : "   ${sink.desc}"})))))

(defwidget network-widget []
  (label :class "network module" :xalign 0.5 :text {network-text}))

(defwidget cpu-widget []
  (eventbox
    :onhover     "~/.config/eww/scripts/popup-open cpu-popup-window cpu-pin"
    :onhoverlost "~/.config/eww/scripts/popup-hover-out cpu-popup-window cpu-pin"
    :onclick     "~/.config/eww/scripts/popup-toggle cpu-popup-window cpu-pin"
    (label :class "cpu module" :xalign 0.5 :text "  ${cpu-usage}%")))

(defwidget temp-widget []
  (eventbox
    :onhover     "~/.config/eww/scripts/popup-open temp-popup-window temp-pin"
    :onhoverlost "~/.config/eww/scripts/popup-hover-out temp-popup-window temp-pin"
    :onclick     "~/.config/eww/scripts/popup-toggle temp-popup-window temp-pin"
    (label :class "temperature module" :xalign 0.5 :text "  ${temperature}°C")))

(defwidget cpu-popup-widget []
  (box :orientation "v" :spacing 2 :class "popup-box"
    (for core in {cpu-cores.cores}
      (box :orientation "h" :spacing 8 :space-evenly false :class "popup-row"
        (label :class "popup-label" :xalign 0 :text "cpu${core.id}")
        (scale :class "popup-bar" :value {core.pct} :min 0 :max 100
               :hexpand true :active false :draw-value false)
        (label :class "popup-pct" :xalign 1 :text "${core.pct}%")))
    (box :class "popup-separator")
    (for proc in {cpu-cores.procs}
      (box :orientation "h" :spacing 8 :space-evenly false :class "popup-row"
        (label :class "popup-label popup-proc-name" :xalign 0 :text {proc.name})
        (label :class "popup-pct" :xalign 1 :text "${proc.pct}%")))))

(defwidget temp-popup-widget []
  (box :orientation "v" :spacing 4 :class "popup-box"
    (for sensor in temperatures
      (box :orientation "h" :spacing 12 :space-evenly false :class "popup-row"
        (label :class "popup-label" :xalign 0 :text "${sensor.device} ${sensor.label}")
        (label :class "popup-temp-val" :xalign 1 :text "${sensor.temp}°C")))))

(defwidget memory-widget []
  (eventbox
    :onhover     "~/.config/eww/scripts/popup-open ram-popup-window ram-pin"
    :onhoverlost "~/.config/eww/scripts/popup-hover-out ram-popup-window ram-pin"
    :onclick     "~/.config/eww/scripts/popup-toggle ram-popup-window ram-pin"
    (label :class "memory module" :xalign 0.5 :text "  ${memory-pct}%")))

(defwidget ram-popup-widget []
  (box :orientation "v" :spacing 2 :class "popup-box"
    (box :orientation "h" :spacing 8 :space-evenly false :class "popup-row"
      (label :class "popup-label" :text "RAM")
      (scale :class "popup-bar" :value {memory-details.used_pct} :min 0 :max 100
             :hexpand true :active false :draw-value false)
      (label :class "popup-mem-val" :text "${memory-details.used} / ${memory-details.total}"))
    (box :orientation "h" :spacing 8 :space-evenly false :class "popup-row"
      (label :class "popup-label" :text "Cache")
      (scale :class "popup-bar popup-bar-cache" :value {memory-details.cache_pct} :min 0 :max 100
             :hexpand true :active false :draw-value false)
      (label :class "popup-mem-val" :text {memory-details.cached}))
    (box :visible {memory-details.has_swap}
         :orientation "h" :spacing 8 :space-evenly false :class "popup-row"
      (label :class "popup-label" :text "Swap")
      (scale :class "popup-bar popup-bar-swap" :value {memory-details.swap_pct} :min 0 :max 100
             :hexpand true :active false :draw-value false)
      (label :class "popup-mem-val" :text "${memory-details.swap_used} / ${memory-details.swap_total}"))
    (box :class "popup-separator")
    (for proc in {memory-details.procs}
      (box :orientation "h" :spacing 8 :space-evenly false :class "popup-row"
        (label :class "popup-label popup-proc-name" :xalign 0 :text {proc.name})
        (label :class "popup-mem-val" :xalign 1 :text {proc.mem})
        (label :class "popup-pct"     :xalign 1 :text "${proc.pct}%")))))

; ── popups ────────────────────────────────────────────────────────────

(defwindow power-popup-window-0
  :monitor 0
  :geometry (geometry :x "10px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (power-popup-widget))

(defwindow power-popup-window-1
  :monitor 1
  :geometry (geometry :x "10px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (power-popup-widget))

(defwindow cpu-popup-window-0
  :monitor 0
  :geometry (geometry :x "152px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (cpu-popup-widget))

(defwindow cpu-popup-window-1
  :monitor 1
  :geometry (geometry :x "152px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (cpu-popup-widget))

(defwindow temp-popup-window-0
  :monitor 0
  :geometry (geometry :x "90px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (temp-popup-widget))

(defwindow temp-popup-window-1
  :monitor 1
  :geometry (geometry :x "90px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (temp-popup-widget))

(defwindow sink-popup-window-0
  :monitor 0
  :geometry (geometry :x "370px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (sink-popup-widget))

(defwindow sink-popup-window-1
  :monitor 1
  :geometry (geometry :x "370px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (sink-popup-widget))

(defwindow ram-popup-window-0
  :monitor 0
  :geometry (geometry :x "36px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (ram-popup-widget))

(defwindow ram-popup-window-1
  :monitor 1
  :geometry (geometry :x "36px" :y "40px" :anchor "top right")
  :stacking "fg" :focusable false
  (ram-popup-widget))


; ── window ────────────────────────────────────────────────────────────

(defwindow bar
  :monitor 1
  :geometry (geometry
    :x "0%"
    :y "0px"
    :width "100%"
    :height "36px"
    :anchor "top center")
  :stacking "bottom"
  :exclusive true
  :focusable false
  (bar :wss workspaces))

(defwindow bar2
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0px"
    :width "100%"
    :height "36px"
    :anchor "top center")
  :stacking "bottom"
  :exclusive true
  :focusable false
  (bar :wss workspaces2))
