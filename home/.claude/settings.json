{
  "env": {
    "ANTHROPIC_BASE_URL": "https://sub2api.eqzotiqqq.dedyn.io",
    "ANTHROPIC_AUTH_TOKEN": "$SUB2API_KEY_ANTHROPIC_KEY",
    "ANTHROPIC_MODEL": "claude-opus-5.5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "engineering@knowledge-work-plugins": true,
    "product-management@knowledge-work-plugins": true,
    "cowork-plugin-management@knowledge-work-plugins": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-summary"
          }
        ]
      }
    ]
  }
}