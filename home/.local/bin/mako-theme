#!/usr/bin/env python3
"""mako-theme — mako's colors, border and rounding from the shared theme ~/.config/theme/theme.json.

Writes ~/.cache/mako-theme (pulled in by `include=` in ~/.config/mako/config) and reloads a running mako.
Runs before mako at login (hyprland.lua autostart) and from Quickshell whenever theme.json changes.
mako refuses to start without the included file, so an unreadable theme still writes one: mako's defaults.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

THEME = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "theme" / "theme.json"
OUT = Path.home() / ".cache" / "mako-theme"  # spelled out in mako/config: `include` takes no env vars


def rgba(color, alpha=1.0):
    return f"{color}{round(alpha * 255):02x}"


def render(theme):
    c = theme["colors"]
    shape = theme.get("shape", {})
    popout = theme.get("opacity", {}).get("popout", 0.92)
    return f"""\
# generated by mako-theme from {THEME}: edit the theme, not this file
background-color={rgba(c["surface"], popout)}
text-color={rgba(c["onSurface"])}
border-color={rgba(c["primary"])}
progress-color=over {rgba(c["primaryContainer"])}
border-size={shape.get("border", 1)}
border-radius={shape.get("rounding", 8)}

[urgency=low]
border-color={rgba(c["outline"])}

[urgency=critical]
border-color={rgba(c["error"])}
text-color={rgba(c["error"])}
background-color={rgba(c["surface"])}
"""


try:
    text = render(json.loads(THEME.read_text()))
except (OSError, ValueError, KeyError) as e:
    print(f"mako-theme: {THEME}: {e!r}", file=sys.stderr)
    text = "# mako-theme: theme.json unreadable, mako's default look\n"

OUT.parent.mkdir(parents=True, exist_ok=True)
OUT.write_text(text)
subprocess.run(["makoctl", "reload"], stderr=subprocess.DEVNULL)  # fails quietly while mako isn't running
