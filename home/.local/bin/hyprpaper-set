#!/usr/bin/env bash
# hyprpaper-set — pick a wallpaper via wofi and apply to all monitors
#
# Usage:
#   hyprpaper-set              — open wofi picker (with thumbnails) from ~/Pictures/wallpapers/
#   hyprpaper-set /path/to/img — apply directly without picker


apply() {
  local img="$1"
  local monitors
  mapfile -t monitors < <(hyprctl monitors -j | \
    python3 -c "import sys,json; [print(m['name']) for m in json.load(sys.stdin)]")

  for mon in "${monitors[@]}"; do
    hyprctl hyprpaper wallpaper "$mon,$img"
    echo "hyprctl hyprpaper wallpaper $mon,$img"
  done
}

# ── direct path ───────────────────────────────────────────────
if [[ -n "$1" ]]; then
  [[ ! -f "$1" ]] && { echo "File not found: $1" >&2; exit 1; }
  apply "$1"; exit $?
fi

# ── pick via wofi ─────────────────────────────────────────────
if [[ ! -d "${WALLPAPER_DIR}" ]]; then
  echo "Wallpaper dir not found: ${WALLPAPER_DIR}" >&2
  echo "Create it or set WALLPAPER_DIR env var." >&2
  exit 1
fi

mapfile -t images < <(
  find -L "${WALLPAPER_DIR}" -type f \( \
    -iname "*.jpg" -o -iname "*.jpeg" -o \
    -iname "*.png" -o -iname "*.webp"  \
  \) | sort
)

[[ ${#images[@]} -eq 0 ]] && { echo "No images found in ${WALLPAPER_DIR}" >&2; exit 1; }

# a row per image: 16:9 thumbnail (cached, rebuilt when the image changes) + its path inside WALLPAPER_DIR
thumbs="${XDG_CACHE_HOME:-$HOME/.cache}/hyprpaper-set"
mkdir -p "$thumbs"

selected=$(
  for img in "${images[@]}"; do
    thumb="$thumbs/$(printf '%s' "$img" | md5sum | cut -d' ' -f1).png"
    [[ "$thumb" -nt "$img" ]] || magick "$img" -thumbnail 320x180^ -gravity center -extent 320x180 "$thumb"
    printf 'img:%s:text:%s\n' "$thumb" "${img#"${WALLPAPER_DIR%/}"/}"
  done | wofi --dmenu --prompt "Wallpaper" --insensitive --lines 4 --define image_size=160
)

[[ -z "$selected" ]] && exit 0
selected="${WALLPAPER_DIR%/}/${selected##*:text:}"

echo "$selected"
apply "$selected"



