#!/usr/bin/env bash
# Switch to workspace N on the focused monitor (AwesomeWM style)
# DP-2 (primary): workspaces 1-9
# DP-1 (secondary): workspaces 10-18
N=$1
MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .name')
[[ "$MONITOR" == "DP-2" ]] && hyprctl dispatch workspace "$N" || hyprctl dispatch workspace "$((N + 9))"
