#!/usr/bin/env python3
"""Archive the complete Codex transcript when a session ends."""

import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def save(event):
    if not event["transcript_path"]:
        return

    source = Path(event["transcript_path"])
    directory = Path.home() / "codex-conversations-history" / Path(event["cwd"]).name
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    output = directory / f"{event['session_id']}.jsonl"
    with tempfile.NamedTemporaryFile(dir=directory, suffix=".tmp", delete=False) as stream:
        temporary = Path(stream.name)
        try:
            with source.open("rb") as transcript:
                shutil.copyfileobj(transcript, stream)
            temporary.replace(output)
        finally:
            temporary.unlink(missing_ok=True)


def main():
    if sys.argv[1:2] == ["--run"]:
        save(json.loads(sys.argv[2]))
        return

    event = json.load(sys.stdin)
    log = Path.home() / ".cache/codex-session-history.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a") as stream:
        subprocess.Popen([
            sys.executable, str(Path(__file__).resolve()), "--run", json.dumps(event),
        ], stdin=subprocess.DEVNULL, stdout=stream, stderr=stream, start_new_session=True)


if __name__ == "__main__":
    main()
